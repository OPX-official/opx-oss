<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    android:layoutAnimation="@anim/layout_stagger_up"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- Stryker's dashboard hero: a rounded accent bar that starts the main action. -->
        <LinearLayout
            android:id="@+id/home_hero_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dash_hero_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/wifi_scan"
                android:src="@drawable/scanner"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/home_hero_scan"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/DashboardSection"
            android:text="@string/home_section_runtime" />

        <!-- Stryker's engine card: a state animation beside the title, the detail underneath and
             the state chip on the right. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/light_contrast"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_lite_contrast"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/home_engine_anim"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/home_section_runtime"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/connection" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_runtime_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/home_runtime_value"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_runtime_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="@string/home_runtime_body"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_runtime_chip"
                    style="@style/DashboardRowCount"
                    android:text="—" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/DashboardSection"
            android:text="@string/home_modules_title" />

        <!-- Stryker's rows live inside one tinted sheet, divided by the padding alone. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dash_card_bg"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/home_module_wifi"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:contentDescription="@string/nav_wifi"
                    android:src="@drawable/latest_wifi"
                    app:tint="@color/stryker_accent" />

                <TextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/nav_wifi" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:contentDescription="@string/nav_wifi"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_module_logs"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:contentDescription="@string/nav_logs"
                    android:src="@drawable/terminal"
                    app:tint="#5E35B1" />

                <TextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/nav_logs" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:contentDescription="@string/nav_logs"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_row_settings"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/settings"
                    app:tint="#00897B" />

                <TextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/nav_settings" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_row_about"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:contentDescription="@string/nav_about"
                    android:src="@drawable/info_outlined"
                    app:tint="@color/accent_nuclei" />

                <TextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/nav_about" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:contentDescription="@string/nav_about"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="@string/home_footer"
            android:textColor="@color/grey"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
