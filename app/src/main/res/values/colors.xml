    <color name="opx_text">@color/night_contrast_2</color>
    <color name="opx_muted">@color/grey</color>
    <color name="opx_green">@color/green</color>


    <!-- Intro screen, light theme. values-night overrides these; lint requires every color that
         exists in a qualified folder to have a base declaration, or a non-night device crashes. -->
    <color name="intro_ink">#0B1220</color>
    <color name="intro_line_1">#1565C0</color>
    <color name="intro_line_2">#304FFE</color>
