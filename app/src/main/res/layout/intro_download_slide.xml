<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Stryker's install slide animation: 67dp, tinted with the intro colour. -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/download_anim"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:paddingBottom="5dp"
        app:lottie_autoPlay="true"
        app:lottie_colorFilter="@color/stryker_accent"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/icon_morph" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:text="@string/intro_eyebrow_install"
        android:textAllCaps="true"
        android:textColor="@color/stryker_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/download_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/intro_download_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/download_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/stryker_accent"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/download_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/download_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/intro_download_wait"
            android:textColor="@color/grey"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        app:indicatorColor="@color/stryker_accent"
        app:trackColor="@color/intro_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="3dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/download_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/grey"
        android:textSize="11sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/download_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textColor="@color/grey"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/download_details"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/intro_show_details"
        android:textColor="@color/stryker_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/download_action"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/intro_retry"
        android:visibility="gone"
        app:cornerRadius="14dp" />
</LinearLayout>
