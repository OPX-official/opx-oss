<?xml version="1.0" encoding="utf-8"?>
<!-- One saved capture, the shape Stryker's handshake_item uses: icon tile, SSID, a detail line,
     a kind/cracked pill, and the crack action on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hs_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dashboard_tile_bg_orange">

            <ImageView
                android:id="@+id/hs_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/hs_title"
                android:src="@drawable/file"
                app:tint="#FB8C00" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hs_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/night_contrast_2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hs_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/grey"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hs_time_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/grey"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/hs_state_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/hs_kind_handshake"
            android:textColor="#388E3C"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/hs_brute"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/hs_action_crack"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/key"
            app:tint="@color/stryker_accent" />

        <ImageView
            android:id="@+id/hs_overflow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/hs_action_more"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/tune"
            app:tint="@color/grey" />
    </LinearLayout>

    <TextView
        android:id="@+id/hs_date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="72dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:textColor="@color/stryker_accent"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:id="@+id/hs_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="72dp"
        android:background="@color/light_lite_contrast" />
</LinearLayout>
