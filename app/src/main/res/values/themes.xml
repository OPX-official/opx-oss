<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Opx" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/stryker_accent</item>
        <item name="colorPrimaryDark">@color/toolbar_color</item>
        <item name="colorPrimaryVariant">@color/stryker_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/stryker_accent</item>
        <item name="colorSecondaryVariant">@color/stryker_accent_contrast</item>
        <item name="colorOnSecondary">@color/stryker_accent_contrast</item>
        <item name="colorSurface">@color/light_contrast</item>
        <item name="colorSurfaceVariant">@color/light_lite_contrast</item>
        <item name="colorOnSurface">@color/night_contrast_2</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="colorOutline">@color/light_lite_contrast</item>
        <item name="android:colorBackground">@color/light_contrast</item>
        <item name="android:statusBarColor">@color/toolbar_color</item>
        <item name="android:navigationBarColor">@color/toolbar_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/night_contrast_2</item>
        <item name="android:textViewStyle">@style/Widget.Opx.TextView</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:buttonStyle">@style/Widget.Opx.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Opx.CardView</item>
        <item name="materialAlertDialogTheme">@style/Widget.Opx.AlertDialog</item>
    </style>

    <!-- Stryker's Widget.Stryker.AlertDialog -->
    <style name="Widget.Opx.AlertDialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/light_contrast</item>
    </style>

    <!-- Stryker's Widget.Stryker.CardView -->
    <style name="Widget.Opx.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="android:backgroundTint">@color/dialog_background_color</item>
    </style>

    <!-- Stryker's Widget.Stryker.Button -->
    <style name="Widget.Opx.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Stryker's Widget.Stryker.TextView -->
    <style name="Widget.Opx.TextView" parent="android:TextAppearance.Material.Widget.TextView">
        <item name="android:fontFamily">@font/lato</item>
    </style>

    <!-- The visible card in every screen: white, 20dp, hairline stroke, no shadow. -->
    <style name="OpxCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/light_contrast</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/light_lite_contrast</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Stryker's section rows: a 44dp icon tile with the title and its body underneath. -->
    <style name="OpxRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="OpxSectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/stryker_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Stryker's screen title: 28sp bold, ink black. -->
    <style name="OpxTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/night_contrast_2</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="OpxBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="OpxCardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/night_contrast_2</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="OpxMetaLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OpxMetaValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/night_contrast_2</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Stryker's dashboard vocabulary: big bold section headers, rows inside a tinted sheet,
         round count chips and a chevron. -->
    <style name="DashboardSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DashboardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="DashboardRowIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/settings_icon_bg</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="DashboardRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DashboardRowCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/dash_count_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DashboardRowChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">@color/dash_secondary</item>
    </style>

    <style name="OpxPill" parent="">
        <item name="android:background">@drawable/chip_pill_bg</item>
        <item name="android:backgroundTint">@color/light_lite_contrast</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grey</item>
    </style>

</resources>
