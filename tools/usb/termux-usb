#!/usr/bin/env python3
"""``termux-usb`` for OPX OSS -- same command line, no Termux:API app.

wifi4 shells out to ``termux-usb -l`` and ``termux-usb -r -E -e <callback> <device>``.
This drop-in implementation talks to the OPX OSS USB host bridge inside the app instead of
the Termux:API broadcast receiver, so the single APK is the only thing installed.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ.get("PREFIX", "/data/data/com.termux/files/usr"),
                                "lib/opx/python"))

import opx_usb  # noqa: E402


def usage(message=None):
    if message:
        sys.stderr.write(f"termux-usb: {message}\n")
    sys.stderr.write(
        "usage: termux-usb [-l | -r [-E] -e <callback> <device>]\n"
        "  -l  list attached USB device paths as JSON\n"
        "  -r  request the device and run the callback with TERMUX_USB_FD set\n"
    )
    return 1


def main(argv):
    if not argv:
        return usage()

    if argv[0] in ("-l", "--list"):
        import json

        try:
            print(json.dumps(opx_usb.list_devices()))
        except Exception as exc:
            sys.stderr.write(f"termux-usb: {exc}\n")
            return 1
        return 0

    callback = None
    device = None
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in ("-r", "--request"):
            index += 1
        elif arg in ("-E", "--no-exit"):
            index += 1
        elif arg in ("-e", "--exec"):
            if index + 1 >= len(argv):
                return usage("-e needs a callback")
            callback = argv[index + 1]
            index += 2
        else:
            device = arg
            index += 1

    if device is None or callback is None:
        return usage("both a callback and a device are required")

    try:
        fd = opx_usb.open_device(device)
    except Exception as exc:
        sys.stderr.write(f"termux-usb: {exc}\n")
        return 1

    environment = dict(os.environ)
    environment["TERMUX_USB_FD"] = str(fd)
    environment.setdefault("TERMUX_USB_DEVICE", device)
    try:
        return subprocess.call(["/bin/sh", "-c", callback], env=environment, pass_fds=(fd,))
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
