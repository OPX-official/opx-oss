    <!-- First-run welcome, Stryker's intro with this app's four steps. -->
    <string name="intro_welcome_title">Welcome to OPX OSS</string>
    <string name="intro_welcome_body">The wireless engine, its USB host bridge and the guided interface in one app — no terminal and no companion app.</string>
    <string name="intro_permissions_title">Permissions, once</string>
    <string name="intro_permissions_body">Location powers WiFi scanning, storage keeps captures and logs, notifications show the engine. Grant what your phone allows — setup continues without them, and only the features that need one stay off.</string>
    <string name="intro_download_title">Download the engine</string>
    <string name="intro_download_body">The app is small by design. It detects a 32-bit or 64-bit phone, downloads only that runtime, verifies every file, and resumes where it stopped if the connection drops.</string>
    <string name="intro_engine_title">The engine installs itself</string>
    <string name="intro_engine_body">The verified runtime unpacks into the app\'s own private directory. This happens once; later launches reuse the installed tree.</string>
    <string name="intro_ready_title">Ready to scan</string>
    <string name="intro_ready_body">The engine stays warm in the background, so every screen sees the same state — and WiFi works the moment you open it.</string>
