#!/data/data/com.opx.oss/files/usr/bin/python3
# The line above must be an absolute interpreter path: wifi4 execs this file directly, and
# Android has no /usr/bin/env, so a "#!/usr/bin/env python3" line makes execve fail with ENOENT
# and wifi4 reports "opx-usb is unavailable" as if the USB permission were missing. This is the
# prefix's own python (OpxRuntime.PREFIX_GUEST), the same interpreter that runs the engine.
"""``opx-usb`` for OPX OSS: the command the engine runs, with no second app.

wifi4 shells out to ``opx-usb -l`` and ``opx-usb -r |-E -e <callback> <device>``.
This is a native script inside the OPX OSS runtime: it talks to the in-app USB host bridge
over the abstract socket (see ``opx_usb.py``), which asks Android for the device permission
and returns the descriptor over SCM_RIGHTS. Everything lives in this app.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ.get("PREFIX", "/data/data/com.opx.oss/files/usr"),
                                "lib/opx/python"))

import opx_usb  # noqa: E402


def usage(message=None):
    if message:
        sys.stderr.write(f"opx-usb: {message}\n")
    sys.stderr.write(
        "usage: opx-usb [-l | -r [-E] -e <callback> <device>]\n"
        "  -l  list attached USB device paths as JSON\n"
        "  -r  request the device and run the callback with OPX_USB_FD set\n"
    )
    return 1


def main(argv):
    if not argv:
        return usage()

    if argv[0] in ("-l", "--list"):
        import json

        try:
            print(json.dumps(opx_usb.list_devices()))
        except Exception as exc:
            sys.stderr.write(f"opx-usb: {exc}\n")
            return 1
        return 0

    callback = None
    device = None
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in ("-r", "--request"):
            index += 1
        elif arg in ("-E", "--no-exit"):
            index += 1
        elif arg in ("-e", "--exec"):
            if index + 1 >= len(argv):
                return usage("-e needs a callback")
            callback = argv[index + 1]
            index += 2
        else:
            device = arg
            index += 1

    if device is None or callback is None:
        return usage("both a callback and a device are required")

    try:
        fd = opx_usb.open_device(device)
    except Exception as exc:
        sys.stderr.write(f"opx-usb: {exc}\n")
        return 1

    environment = dict(os.environ)
    environment["OPX_USB_FD"] = str(fd)
    environment.setdefault("OPX_USB_DEVICE", device)
    try:
        return subprocess.call(["/system/bin/sh", "-c", callback], env=environment,
                                pass_fds=(fd,))
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
