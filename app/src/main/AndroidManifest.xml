<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- ~/storage (the termux-setup-storage equivalent); targetSdk 28 keeps these ordinary
         runtime permissions rather than scoped-storage media permissions. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".OpxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opx"
        tools:targetApi="n">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Opx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Long-press the app icon: the terminal is one tap away. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".TerminalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Opx.Terminal"
            android:windowSoftInputMode="adjustResize" />

        <!-- The terminal's own launcher entry, exactly like Stryker's TerminalLauncher alias:
             one APK and one install, but the terminal also appears as a shortcut icon that opens
             it directly, without walking through the main UI first. -->
        <activity-alias
            android:name=".TerminalShortcut"
            android:exported="true"
            android:icon="@drawable/ic_terminal_launcher"
            android:label="@string/terminal_launcher_label"
            android:roundIcon="@drawable/ic_terminal_launcher"
            android:targetActivity=".TerminalActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The engine: installs the Termux userland when the app starts, keeps the terminal
             sessions alive in the background and shows the ongoing notification with Exit. -->
        <service
            android:name=".OpxService"
            android:exported="false"
            android:stopWithTask="false" />

    </application>

</manifest>
