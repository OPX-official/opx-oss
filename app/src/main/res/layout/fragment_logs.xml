<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_color"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/logs_title"
                android:textColor="@color/night_contrast_2"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/logs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/logs_count"
                android:textColor="@color/grey"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/logs_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logs_share"
            android:padding="8dp"
            android:src="@drawable/share"
            app:tint="@color/night_contrast" />

        <ImageView
            android:id="@+id/logs_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logs_copy"
            android:padding="8dp"
            android:src="@drawable/copy"
            app:tint="@color/night_contrast" />

        <ImageView
            android:id="@+id/logs_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logs_clear"
            android:padding="8dp"
            android:src="@drawable/delete"
            app:tint="@color/night_contrast" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:text="@string/logs_subtitle"
        android:textAppearance="@style/OpxBody"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/logs_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <!-- Stryker's console: the log sits on the same near-black surface as its logger. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Stryker's empty-state animation, shown instead of an empty console. -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/logs_empty_anim"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:paddingTop="14dp"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/nothing" />

                <TextView
                    android:id="@+id/logs_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:textColor="#D7DAE0"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

</LinearLayout>
