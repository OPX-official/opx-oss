    <!-- OPX aliases: old names now resolve to the Stryker palette, so no screen can
         fall back to the previous dark theme. -->
    <color name="opx_bg">@color/light_contrast</color>
    <color name="opx_surface">@color/light_contrast</color>
    <color name="opx_surface_alt">@color/light_lite_contrast</color>
