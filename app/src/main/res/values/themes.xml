<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Opx" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/opx_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/opx_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/opx_text</item>
        <item name="colorSecondary">@color/opx_accent</item>
        <item name="colorSurface">@color/opx_surface</item>
        <item name="colorSurfaceVariant">@color/opx_surface_alt</item>
        <item name="colorOnSurface">@color/opx_text</item>
        <item name="colorOnSurfaceVariant">@color/opx_muted</item>
        <item name="colorOutline">@color/opx_stroke</item>
        <item name="android:colorBackground">@color/opx_bg</item>
        <item name="android:statusBarColor">@color/opx_bg</item>
        <item name="android:navigationBarColor">@color/opx_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/opx_text</item>
    </style>

    <style name="OpxCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/opx_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/opx_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="OpxSectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/opx_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OpxTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/opx_text</item>
    </style>

    <style name="OpxBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/opx_muted</item>
    </style>

</resources>
