<?xml version="1.0" encoding="utf-8"?>
<!-- One row of wifi4's packet dashboard: the class name in its own colour, that class's
     sparkline, and the rate it is running at right now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/meter_label"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textSize="9sp"
        android:textStyle="bold" />

    <com.opx.oss.SparklineView
        android:id="@+id/meter_graph"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/meter_value"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="end"
        android:maxLines="1"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
